{
  "entities": {
    "user": {
      "title": "User",
      "description": "User account document",
      "type": "object",
      "properties": {
        "email": {
          "type": "string",
          "format": "email"
        },
        "dataCriacao": {
          "type": "string"
        }
      },
      "required": [
        "email",
        "dataCriacao"
      ]
    },
    "character": {
      "title": "Character",
      "description": "Character document for Realms of Nocthera",
      "type": "object",
      "properties": {
        "nome": {
          "type": "string",
          "minLength": 2,
          "maxLength": 32
        },
        "racaId": {
          "type": "string"
        },
        "classeId": {
          "type": "string"
        },
        "linhagem": {
          "type": "string"
        },
        "nivel": {
          "type": "number"
        },
        "xpAtual": {
          "type": "number"
        },
        "pontosDisponiveis": {
          "type": "number"
        },
        "ouro": {
          "type": "number"
        },
        "atributos": {
          "type": "object",
          "properties": {
            "vigor": {
              "type": "number"
            },
            "sorte": {
              "type": "number"
            },
            "forca": {
              "type": "number"
            },
            "vitalidade": {
              "type": "number"
            },
            "arcano": {
              "type": "number"
            },
            "inteligencia": {
              "type": "number"
            },
            "agilidade": {
              "type": "number"
            }
          },
          "required": [
            "vigor",
            "sorte",
            "forca",
            "vitalidade",
            "arcano",
            "inteligencia",
            "agilidade"
          ]
        }
      },
      "required": [
        "nome",
        "racaId",
        "nivel",
        "xpAtual",
        "pontosDisponiveis",
        "atributos",
        "ouro"
      ]
    },
    "transaction": {
      "title": "Transaction",
      "description": "Registro de alteração de ouro (ganho ou perdido)",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string"
        },
        "tipo": {
          "type": "string",
          "enum": [
            "ganho",
            "perda"
          ]
        },
        "quantidade": {
          "type": "number"
        },
        "motivo": {
          "type": "string"
        },
        "timestamp": {
          "type": "string"
        }
      },
      "required": [
        "uid",
        "tipo",
        "quantidade",
        "motivo",
        "timestamp"
      ]
    },
    "nome": {
      "title": "Nome",
      "description": "Índice de unicidade do nome do personagem (chave = nome normalizado)",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string"
        },
        "nome": {
          "type": "string"
        },
        "criadoEm": {
          "type": "string"
        }
      },
      "required": [
        "uid",
        "nome"
      ]
    },
    "combate": {
      "title": "Combate",
      "description": "Registro de combate: semente do servidor, entrada para replay e resposta para reenvios idempotentes",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string"
        },
        "monstroId": {
          "type": "string"
        },
        "seed": {
          "type": "number"
        },
        "vencedor": {
          "type": "string"
        },
        "xpGanho": {
          "type": "number"
        },
        "ouroGanho": {
          "type": "number"
        },
        "criadoEm": {
          "type": "string"
        }
      },
      "required": [
        "uid",
        "monstroId",
        "seed",
        "vencedor",
        "criadoEm"
      ]
    },
    "revogacao": {
      "title": "Revogação de sessões",
      "description": "Instante (epoch em segundos) do último logout no servidor; tokens com auth_time menor ou igual são recusados",
      "type": "object",
      "properties": {
        "revogadoEm": {
          "type": "number"
        },
        "atualizadoEm": {
          "type": "string"
        }
      },
      "required": [
        "revogadoEm"
      ]
    },
    "papelMestre": {
      "title": "Papel no Painel do Mestre",
      "description": "Papel concedido pelo Dono no painel (mestre, moderador ou suporte). O Dono não é gravado aqui: vem da variável MESTRE_DONO_UIDS do servidor.",
      "type": "object",
      "properties": {
        "papel": {
          "type": "string",
          "enum": [
            "mestre",
            "moderador",
            "suporte"
          ]
        },
        "concedidoPor": {
          "type": "string"
        },
        "concedidoEm": {
          "type": "string"
        },
        "motivo": {
          "type": "string"
        }
      },
      "required": [
        "papel"
      ]
    },
    "logAdmin": {
      "title": "Registro do log administrativo",
      "description": "Quem fez o quê no painel, com antes, depois, motivo e IP. Só se cria: nunca se altera nem se apaga.",
      "type": "object",
      "properties": {
        "criadoEm": {
          "type": "string"
        },
        "uid": {
          "type": "string"
        },
        "email": {
          "type": "string"
        },
        "papel": {
          "type": "string",
          "enum": [
            "dono",
            "mestre",
            "moderador",
            "suporte"
          ]
        },
        "acao": {
          "type": "string"
        },
        "alvo": {
          "type": "string"
        },
        "antes": {},
        "depois": {},
        "motivo": {
          "type": "string"
        },
        "ip": {
          "type": "string"
        }
      },
      "required": [
        "criadoEm",
        "uid",
        "papel",
        "acao"
      ]
    },
    "conteudo": {
      "title": "Conteúdo editável do Painel do Mestre",
      "description": "Um item (mapa, tileset ou monstro) com o rascunho atual e a versão publicada. A chave é <tipo>__<id>. O jogo só lê a versão publicada. O tileset guarda a imagem como PNG em base64 (até 420 KB).",
      "type": "object",
      "properties": {
        "tipo": {
          "type": "string",
          "enum": [
            "mapa",
            "tileset",
            "monstro"
          ]
        },
        "id": {
          "type": "string"
        },
        "nome": {
          "type": "string"
        },
        "revisao": {
          "type": "integer"
        },
        "rascunho": {
          "type": "object"
        },
        "hashRascunho": {
          "type": "string"
        },
        "editadoEm": {
          "type": "string"
        },
        "editadoPor": {
          "type": "string"
        },
        "criadoEm": {
          "type": "string"
        },
        "criadoPor": {
          "type": "string"
        },
        "versaoPublicada": {
          "type": [
            "integer",
            "null"
          ]
        },
        "hashPublicado": {
          "type": [
            "string",
            "null"
          ]
        },
        "ultimaVersao": {
          "type": "integer"
        }
      },
      "required": [
        "tipo",
        "id",
        "nome",
        "revisao",
        "ultimaVersao"
      ]
    },
    "versaoConteudo": {
      "title": "Versão publicada de um conteúdo",
      "description": "Cópia imutável do conteúdo no momento em que foi publicado. Voltar atrás cria uma versão nova com os dados de uma antiga (origem reversao).",
      "type": "object",
      "properties": {
        "versao": {
          "type": "integer"
        },
        "dados": {
          "type": "object"
        },
        "hash": {
          "type": "string"
        },
        "publicadoEm": {
          "type": "string"
        },
        "publicadoPor": {
          "type": "string"
        },
        "motivo": {
          "type": "string"
        },
        "origem": {
          "type": "string",
          "enum": [
            "publicacao",
            "reversao"
          ]
        },
        "revertidaDe": {
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "required": [
        "versao",
        "dados",
        "hash",
        "origem"
      ]
    },
    "sancao": {
      "title": "Sanção de um jogador",
      "description": "Estado da conta (suspensão ou banimento, com prazo e motivo) e o histórico de advertências. Só o servidor lê e grava; a autenticação consulta antes de cada pedido.",
      "type": "object",
      "properties": {
        "tipo": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "suspensao",
            "banimento",
            null
          ]
        },
        "ate": {
          "type": [
            "string",
            "null"
          ]
        },
        "motivo": {
          "type": "string"
        },
        "aplicadaPor": {
          "type": "string"
        },
        "aplicadaEm": {
          "type": "string"
        },
        "advertencias": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "em": {
                "type": "string"
              },
              "por": {
                "type": "string"
              },
              "motivo": {
                "type": "string"
              }
            }
          }
        }
      },
      "required": [
        "tipo"
      ]
    }
  },
  "firestore": {
    "/users/{uid}": {
      "schema": "user",
      "description": "User account metadata"
    },
    "/characters/{uid}": {
      "schema": "character",
      "description": "Player character owned by the user"
    },
    "/transactions/{transactionId}": {
      "schema": "transaction",
      "description": "Histórico de transações de ouro"
    },
    "/nomes/{chave}": {
      "schema": "nome",
      "description": "Índice de nomes únicos (só servidor)"
    },
    "/combates/{combateId}": {
      "schema": "combate",
      "description": "Log de combates (só servidor)"
    },
    "/revogacoes/{uid}": {
      "schema": "revogacao",
      "description": "Revogação de sessões por logout (só servidor)"
    },
    "/mestres/{uid}": {
      "schema": "papelMestre",
      "description": "Papéis do Painel do Mestre (só servidor)"
    },
    "/logAdmin/{id}": {
      "schema": "logAdmin",
      "description": "Log administrativo imutável (só servidor)"
    },
    "/conteudo/{chave}": {
      "schema": "conteudo",
      "description": "Conteúdo editável com rascunho (só servidor)"
    },
    "/conteudo/{chave}/versoes/{versao}": {
      "schema": "versaoConteudo",
      "description": "Versões publicadas, imutáveis (só servidor)"
    },
    "/sancoes/{uid}": {
      "schema": "sancao",
      "description": "Suspensão, banimento e advertências do jogador (só servidor)"
    }
  }
}
